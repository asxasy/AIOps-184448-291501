{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "RateLimiting": {
    "Mode": "IP",
    "MaxRequestsPerMinute": 100,
    "MaxRequestsPerHour": 1000
  },
  "IpRateLimiting": {
    "EnableEndpointRateLimiting": true,
    "StackBlockedRequests": false,
    "RealIpHeader": "",
    "ClientIdHeader": "X-ClientId",
    "HttpStatusCode": 429,
    "QuotaExceededResponse": {
      "Content": "{{\"error\":\"rate_limited\",\"limit\":{0},\"period\":\"{1}\",\"retryAfterSeconds\":{2}}}",
      "ContentType": "application/json",
      "StatusCode": 429
    },
    "IpWhitelist": [],
    "EndpointWhitelist": [
      "get:/health",
      "get:/metrics",
      "get:/test-health",
      "get:/test-health/*",
      "options:*"
    ],
    "GeneralRules": [
      {
        "Endpoint": "*",
        "Period": "1s",
        "Limit": 20
      },
      {
        "Endpoint": "post:/api/login",
        "Period": "1m",
        "Limit": 10
      },
      {
        "Endpoint": "post:/api/login",
        "Period": "1h",
        "Limit": 60
      },
      {
        "Endpoint": "post:/api/users",
        "Period": "1m",
        "Limit": 5
      },
      {
        "Endpoint": "*:/api/invitations*",
        "Period": "1m",
        "Limit": 30
      },
      {
        "Endpoint": "get:/api/purchases/tracking*",
        "Period": "1m",
        "Limit": 30
      },
      {
        "Endpoint": "*:/api/export*",
        "Period": "1m",
        "Limit": 5
      },
      {
        "Endpoint": "get:*",
        "Period": "1m",
        "Limit": 300
      },
      {
        "Endpoint": "post:*",
        "Period": "1m",
        "Limit": 60
      },
      {
        "Endpoint": "put:*",
        "Period": "1m",
        "Limit": 60
      },
      {
        "Endpoint": "delete:*",
        "Period": "1m",
        "Limit": 30
      },
      {
        "Endpoint": "*",
        "Period": "1h",
        "Limit": 5000
      }
    ]
  },
  "IpRateLimitPolicies": {
    "IpRules": []
  },
  "ReverseProxy": {
    "Routes": {
      "users-route": {
        "ClusterId": "users-cluster",
        "Match": {
          "Path": "/api/users/{**catch-all}"
        }
      },
      "roles-route": {
        "ClusterId": "users-cluster",
        "Match": {
          "Path": "/api/roles/{**catch-all}"
        }
      },
      "invitations-route": {
        "ClusterId": "users-cluster",
        "Match": {
          "Path": "/api/invitations/{**catch-all}"
        }
      },
      "login-route": {
        "ClusterId": "users-cluster",
        "Match": {
          "Path": "/api/login/{**catch-all}"
        }
      },
      "users-health-route": {
        "ClusterId": "users-cluster",
        "Match": {
          "Path": "/test-health"
        },
        "Transforms": [
          {
            "PathSet": "/health"
          }
        ]
      },
      "pharmacy-health-route": {
        "ClusterId": "pharmacy-cluster",
        "Match": {
          "Path": "/test-health/pharmacy"
        },
        "Transforms": [
          {
            "PathSet": "/health"
          }
        ]
      },
      "drug-route": {
        "ClusterId": "pharmacy-cluster",
        "Match": {
          "Path": "/api/drug/{**catch-all}"
        }
      },
      "pharmacy-route": {
        "ClusterId": "pharmacy-cluster",
        "Match": {
          "Path": "/api/pharmacy/{**catch-all}"
        }
      },
      "purchases-route": {
        "ClusterId": "pharmacy-cluster",
        "Match": {
          "Path": "/api/purchases/{**catch-all}"
        }
      },
      "stockrequest-route": {
        "ClusterId": "pharmacy-cluster",
        "Match": {
          "Path": "/api/stockrequest/{**catch-all}"
        }
      },
      "unitmeasure-route": {
        "ClusterId": "pharmacy-cluster",
        "Match": {
          "Path": "/api/unitmeasures/{**catch-all}"
        }
      },
      "presentation-route": {
        "ClusterId": "pharmacy-cluster",
        "Match": {
          "Path": "/api/presentations/{**catch-all}"
        }
      },
      "export-route": {
        "ClusterId": "pharmacy-cluster",
        "Match": {
          "Path": "/api/export/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "users-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://pharmago-users-service:80"
          }
        },
        "HealthCheck": {
          "Active": {
            "Enabled": false,
            "Interval": "00:00:10",
            "Timeout": "00:00:05",
            "Policy": "ConsecutiveFailures",
            "Path": "/health"
          }
        }
      },
      "pharmacy-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://pharmago-pharmacy-service:80"
          }
        },
        "HealthCheck": {
          "Active": {
            "Enabled": false,
            "Interval": "00:00:10",
            "Timeout": "00:00:05",
            "Policy": "ConsecutiveFailures",
            "Path": "/health"
          }
        }
      }
    }
  }
}
